# Never commit the real .env file or database password.
SECRET_KEY=replace-with-a-long-random-value

# PostgreSQL connection supplied by the hosting/database provider.
# Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql://friendary_user:password@hostname:5432/friendary

# Use true only after the site is served through HTTPS.
SESSION_COOKIE_SECURE=false
PREFERRED_URL_SCHEME=http
BEHIND_PROXY=false

# PostgreSQL connection pool per Gunicorn worker.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

GMAIL_REDIRECT_URI=http://127.0.0.1:5000/google/gmail/callback
GMAIL_ADMIN_EMAIL=junyoungkim355@gmail.com
UNIVERSITY_API_KEY=your-university-api-key

